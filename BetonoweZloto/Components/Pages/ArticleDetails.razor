@page "/porady/{id:int}"
@using System.Globalization
@rendermode InteractiveServer

<PageTitle>@Article?.Title - BetonoweZloto.pl</PageTitle>

@if (Article == null)
{
    <div class="container mx-auto px-4 py-20 text-center">
        <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
        </div>
        <h2 class="text-2xl font-bold text-gray-900 mb-4">Nie znaleziono artyku³u</h2>
        <p class="text-gray-600 mb-8">Artyku³ o podanym identyfikatorze nie istnieje lub zosta³ usuniêty.</p>
        <a href="/porady" class="inline-flex items-center px-6 py-3 rounded-lg bg-gold-500 text-gray-900 font-bold hover:bg-gold-400 transition-colors shadow-md">
            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            Powrót do bloga
        </a>
    </div>
}
else
{
    <!-- Breadcrumb -->
    <nav class="bg-gray-50 border-b border-gray-200" aria-label="Breadcrumb">
        <div class="container mx-auto px-4 py-4">
            <ol class="flex items-center space-x-2 text-sm">
                <li><a href="/" class="text-gray-600 hover:text-gold-600 transition-colors">Start</a></li>
                <li><svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg></li>
                <li><a href="/porady" class="text-gray-600 hover:text-gold-600 transition-colors">Porady i Blog</a></li>
                <li><svg class="w-4 h-4 text-gray-400" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd"/></svg></li>
                <li><span class="text-gray-900 font-medium">@Article.Title</span></li>
            </ol>
        </div>
    </nav>

    <!-- Article Header -->
    <article class="bg-white">
        <div class="container mx-auto px-4 py-12">
            <div class="max-w-4xl mx-auto">
                <!-- Category and Reading Info -->
                <div class="flex flex-wrap items-center gap-4 mb-6">
                    <span class="px-4 py-2 bg-gold-500 text-gray-900 rounded-full text-sm font-bold">
                        @Article.Category
                    </span>
                    <span class="text-gray-600">
                        <time datetime="@Article.Date.ToString("yyyy-MM-dd")">@Article.Date.ToString("dd MMMM yyyy", new CultureInfo("pl-PL"))</time>
                    </span>
                    <span class="text-gray-600">• @Article.ReadTime min czytania</span>
                    <span class="text-gray-600">• @Article.Views wyœwietleñ</span>
                </div>

                <!-- Title -->
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 mb-6 leading-tight">
                    @Article.Title
                </h1>

                <!-- Excerpt -->
                <p class="text-xl md:text-2xl text-gray-600 leading-relaxed mb-8">
                    @Article.Excerpt
                </p>

                <!-- Author Info -->
                <div class="flex items-center gap-4 pb-8 border-b border-gray-200">
                    <img src="@Article.AuthorPhoto" 
                         alt="@Article.Author" 
                         class="w-16 h-16 rounded-full object-cover"
                         loading="eager" />
                    <div>
                        <div class="text-lg font-bold text-gray-900">@Article.Author</div>
                        <div class="text-gray-600">@Article.AuthorRole</div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Featured Image -->
        <div class="container mx-auto px-4 pb-12">
            <div class="max-w-5xl mx-auto">
                <div class="aspect-[16/9] rounded-2xl overflow-hidden shadow-2xl">
                    <img src="@Article.ImageUrl" 
                         alt="@Article.Title" 
                         class="w-full h-full object-cover"
                         loading="eager" />
                </div>
            </div>
        </div>

        <!-- Article Content -->
        <div class="container mx-auto px-4 pb-12">
            <div class="max-w-4xl mx-auto">
                <div class="prose prose-lg prose-gray max-w-none">
                    @foreach (var contentSection in Article.Content)
                    {
                        @if (contentSection.Type == "heading")
                        {
                            <h2 class="text-3xl font-bold text-gray-900 mt-12 mb-6">@contentSection.Text</h2>
                        }
                        else if (contentSection.Type == "paragraph")
                        {
                            <p class="text-gray-700 leading-relaxed mb-6 text-lg">@contentSection.Text</p>
                        }
                        else if (contentSection.Type == "list")
                        {
                            <ul class="list-disc list-inside space-y-3 mb-6 text-gray-700 text-lg">
                                @foreach (var item in contentSection.Items)
                                {
                                    <li class="pl-2">@item</li>
                                }
                            </ul>
                        }
                        else if (contentSection.Type == "quote")
                        {
                            <blockquote class="border-l-4 border-gold-500 pl-6 py-4 my-8 bg-gray-50 rounded-r-lg">
                                <p class="text-xl italic text-gray-800 leading-relaxed">@contentSection.Text</p>
                            </blockquote>
                        }
                    }
                </div>

                <!-- Tags -->
                <div class="mt-12 pt-8 border-t border-gray-200">
                    <h3 class="text-sm font-semibold text-gray-500 mb-4 uppercase tracking-wide">Tagi</h3>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var tag in Article.Tags)
                        {
                            <span class="px-4 py-2 bg-gray-100 text-gray-700 rounded-full text-sm hover:bg-gray-200 transition-colors cursor-pointer">
                                #@tag
                            </span>
                        }
                    </div>
                </div>

                <!-- Share Section -->
                <div class="mt-12 pt-8 border-t border-gray-200">
                    <h3 class="text-lg font-bold text-gray-900 mb-4">Udostêpnij artyku³</h3>
                    <div class="flex gap-4">
                        <button @onclick="@(() => ShareArticle("facebook"))" 
                                class="flex items-center gap-2 px-6 py-3 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors font-semibold focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-600/50">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                            </svg>
                            Facebook
                        </button>
                        <button @onclick="@(() => ShareArticle("twitter"))" 
                                class="flex items-center gap-2 px-6 py-3 bg-gray-900 text-white rounded-lg hover:bg-gray-800 transition-colors font-semibold focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-900/50">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
                            </svg>
                            Twitter
                        </button>
                        <button @onclick="@(() => ShareArticle("linkedin"))" 
                                class="flex items-center gap-2 px-6 py-3 bg-blue-700 text-white rounded-lg hover:bg-blue-800 transition-colors font-semibold focus:outline-none focus-visible:ring-4 focus-visible:ring-blue-700/50">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
