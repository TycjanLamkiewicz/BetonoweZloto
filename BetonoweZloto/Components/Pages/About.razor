@page "/o-nas"
@using BetonoweZloto.Resources
@inject LocalizationHelper L
@inject LanguageService LanguageService
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@L.Get(LocalizationResources.AboutPage.Title) - BetonoweZloto.pl</PageTitle>

<section class="relative bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white py-20">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
                @L.Get(LocalizationResources.AboutPage.Title)
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
                @L.Get(LocalizationResources.AboutPage.Subtitle)
            </p>
        </div>
    </div>
</section>

<section class="py-20 bg-white">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-20">
                <div>
                    <h2 class="text-4xl font-bold text-gray-900 mb-6">@L.Get(LocalizationResources.AboutPage.HistoryTitle)</h2>
                    <div class="space-y-4 text-gray-600 leading-relaxed">
                        <p>@L.Get(LocalizationResources.AboutPage.HistoryText1)</p>
                        <p>@L.Get(LocalizationResources.AboutPage.HistoryText2)</p>
                        <p>@L.Get(LocalizationResources.AboutPage.HistoryText3)</p>
                    </div>
                </div>
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1560518883-ce09059eeffa?q=80&w=800" 
                         alt="@L.Get(LocalizationResources.AboutPage.HistoryTitle)" 
                         class="rounded-2xl shadow-2xl w-full h-96 object-cover"
                         loading="lazy" />
                    <div class="absolute -bottom-6 -left-6 bg-gold-500 text-gray-900 p-6 rounded-xl shadow-xl">
                        <div class="text-4xl font-bold">15+</div>
                        <div class="text-sm font-semibold">@L.Get(LocalizationResources.AboutPage.ExperienceYears)</div>
                    </div>
                </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-20">
                <div class="text-center p-6 bg-gray-50 rounded-xl">
                    <div class="text-4xl font-bold text-gold-600 mb-2">500+</div>
                    <div class="text-gray-700 font-medium">@L.Get(LocalizationResources.AboutPage.StatsClients)</div>
                </div>
                <div class="text-center p-6 bg-gray-50 rounded-xl">
                    <div class="text-4xl font-bold text-gold-600 mb-2">800+</div>
                    <div class="text-gray-700 font-medium">@L.Get(LocalizationResources.AboutPage.StatsProperties)</div>
                </div>
                <div class="text-center p-6 bg-gray-50 rounded-xl">
                    <div class="text-4xl font-bold text-gold-600 mb-2">15</div>
                    <div class="text-gray-700 font-medium">@L.Get(LocalizationResources.AboutPage.StatsYears)</div>
                </div>
                <div class="text-center p-6 bg-gray-50 rounded-xl">
                    <div class="text-4xl font-bold text-gold-600 mb-2">98%</div>
                    <div class="text-gray-700 font-medium">@L.Get(LocalizationResources.AboutPage.StatsRecommendations)</div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-20 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-4xl font-bold text-gray-900 text-center mb-4">@L.Get(LocalizationResources.AboutPage.ValuesTitle)</h2>
            <p class="text-xl text-gray-600 text-center mb-16">@L.Get(LocalizationResources.AboutPage.ValuesSubtitle)</p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.AboutPage.TrustTitle)</h3>
                    <p class="text-gray-600 leading-relaxed">@L.Get(LocalizationResources.AboutPage.TrustText)</p>
                </div>
                
                <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.AboutPage.ProfessionalismTitle)</h3>
                    <p class="text-gray-600 leading-relaxed">@L.Get(LocalizationResources.AboutPage.ProfessionalismText)</p>
                </div>
                
                <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow">
                    <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                        <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.AboutPage.PassionTitle)</h3>
                    <p class="text-gray-600 leading-relaxed">@L.Get(LocalizationResources.AboutPage.PassionText)</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="py-20 bg-white">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            <h2 class="text-4xl font-bold text-gray-900 text-center mb-4">@L.Get(LocalizationResources.AboutPage.TeamTitle)</h2>
            <p class="text-xl text-gray-600 text-center mb-16">@L.Get(LocalizationResources.AboutPage.TeamSubtitle)</p>
            
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                @foreach (var agent in TeamMembers)
                {
                    <article class="group">
                        <div class="relative overflow-hidden rounded-2xl mb-4 aspect-[3/4]">
                            <img src="@agent.PhotoUrl" 
                                 alt="@agent.Name - @agent.Position" 
                                 class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                 loading="lazy" />
                            <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-gray-900/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                                <div class="absolute bottom-0 left-0 right-0 p-6 transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                                    <div class="flex gap-3">
                                        <a href="tel:@agent.Phone" 
                                           class="flex-1 px-4 py-2 bg-white text-gray-900 rounded-lg text-center font-semibold hover:bg-gold-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
                                           aria-label="Zadzwoñ do @agent.Name">
                                            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                            </svg>
                                        </a>
                                        <a href="mailto:@agent.Email" 
                                           class="flex-1 px-4 py-2 bg-white text-gray-900 rounded-lg text-center font-semibold hover:bg-gold-500 transition-colors focus:outline-none focus-visible:ring-2 focus-visible:ring-white"
                                           aria-label="Napisz email do @agent.Name">
                                            <svg class="w-5 h-5 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="text-center">
                            <h3 class="text-xl font-bold text-gray-900 mb-1">@agent.Name</h3>
                            <p class="text-gold-600 font-semibold mb-2">@agent.Position</p>
                            <p class="text-sm text-gray-600 mb-3">@agent.Specialization</p>
                            <div class="flex justify-center gap-2 text-sm text-gray-500">
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    @agent.ExperienceYears&nbsp;@L.Get(LocalizationResources.AboutPage.YearsShort)
                                </span>
                                <span class="text-gray-300">|</span>
                                <span class="flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                    </svg>
                                    @agent.PropertiesSold+&nbsp;@L.Get(LocalizationResources.AboutPage.OffersShort)
                                </span>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    </div>
</section>

<section class="py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white">
    <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl md:text-5xl font-bold mb-6">
            @L.Get(LocalizationResources.HomePage.CtaHeading)
        </h2>
        <p class="text-xl mb-8 text-gray-300 max-w-2xl mx-auto">
            @L.Get(LocalizationResources.HomePage.CtaText)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="tel:+48123456789" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-gold-500 text-gray-900 hover:bg-gold-400 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gold-500/50 touch-manipulation"
               aria-label="Zadzwoñ do nas: +48 123 456 789">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                +48&nbsp;123&nbsp;456&nbsp;789
            </a>
            <a href="mailto:kontakt@betonowezloto.pl" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 border-2 border-white/30 focus:outline-none focus:ring-4 focus:ring-white/50 touch-manipulation"
               aria-label="Napisz do nas email na adres kontakt@betonowezloto.pl">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                kontakt@betonowezloto.pl
            </a>
        </div>
    </div>
</section>

