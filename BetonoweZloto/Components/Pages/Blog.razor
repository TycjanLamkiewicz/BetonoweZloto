@page "/porady"

<PageTitle>Porady i Blog - BetonoweZloto.pl</PageTitle>

<!-- Hero Section -->
<section class="relative bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white py-20">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">
                Porady Ekspertów
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">
                Praktyczne wskazówki, aktualnoœci z&nbsp;rynku nieruchomoœci i&nbsp;przewodniki dla kupuj¹cych i&nbsp;sprzedaj¹cych
            </p>
        </div>
    </div>
</section>

<!-- Featured Article -->
@if (FilteredArticles.Any())
{
    var featured = FilteredArticles.First();
    <section class="py-12 bg-gray-50">
        <div class="container mx-auto px-4">
            <div class="max-w-6xl mx-auto">
                <article class="bg-white rounded-2xl shadow-xl overflow-hidden">
                    <div class="grid grid-cols-1 lg:grid-cols-2">
                        <div class="relative aspect-[4/3] lg:aspect-auto">
                            <img src="@featured.ImageUrl" 
                                 alt="@featured.Title" 
                                 class="w-full h-full object-cover"
                                 loading="eager" />
                            <div class="absolute top-4 left-4 bg-gold-500 text-gray-900 px-4 py-2 rounded-full font-bold text-sm">
                                Wyró¿niony
                            </div>
                        </div>
                        <div class="p-8 lg:p-12 flex flex-col justify-center">
                            <div class="flex items-center gap-3 mb-4">
                                <span class="px-3 py-1 bg-gold-100 text-gold-800 rounded-full text-sm font-semibold">
                                    @featured.Category
                                </span>
                                <span class="text-sm text-gray-500">
                                    <time datetime="@featured.Date.ToString("yyyy-MM-dd")">@featured.Date.ToString("dd.MM.yyyy")</time>
                                </span>
                                <span class="text-sm text-gray-500">• @featured.ReadTime&nbsp;min</span>
                            </div>
                            <h2 class="text-3xl md:text-4xl font-bold text-gray-900 mb-4">@featured.Title</h2>
                            <p class="text-lg text-gray-600 mb-6 leading-relaxed">@featured.Excerpt</p>
                            <div class="flex items-center gap-4 mb-6">
                                <img src="@featured.AuthorPhoto" 
                                     alt="@featured.Author" 
                                     class="w-12 h-12 rounded-full object-cover"
                                     loading="lazy" />
                                <div>
                                    <div class="font-semibold text-gray-900">@featured.Author</div>
                                    <div class="text-sm text-gray-600">@featured.AuthorRole</div>
                                </div>
                            </div>
                            <a href="/porady/@featured.Id"
                               class="inline-flex items-center px-6 py-3 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-900/50 touch-manipulation self-start">
                                Czytaj wiêcej
                                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                                </svg>
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
}

<!-- Articles Grid -->
<section class="py-12 bg-gray-50">
    <div class="container mx-auto px-4">
        <div class="max-w-6xl mx-auto">
            @if (!FilteredArticles.Any())
            {
                <div class="text-center py-16">
                    <svg class="w-24 h-24 text-gray-300 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    <h3 class="text-2xl font-bold text-gray-900 mb-4">Brak artyku³ów</h3>
                    <p class="text-gray-600 mb-8">W tej kategorii nie ma jeszcze artyku³ów</p>
                </div>
            }
            else
            {
                <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                    @foreach (var article in FilteredArticles.Skip(1))
                    {
                        <article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow duration-300 group flex flex-col">
                            <div class="relative overflow-hidden aspect-[16/9]">
                                <img src="@article.ImageUrl" 
                                     alt="@article.Title" 
                                     class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                                     loading="lazy" />
                                <div class="absolute top-4 left-4 bg-white/90 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-semibold text-gray-900">
                                    @article.Category
                                </div>
                            </div>
                            <div class="p-6 flex-1 flex flex-col">
                                <div class="flex items-center gap-3 mb-3 text-sm text-gray-500">
                                    <time datetime="@article.Date.ToString("yyyy-MM-dd")">@article.Date.ToString("dd.MM.yyyy")</time>
                                    <span>•</span>
                                    <span>@article.ReadTime&nbsp;min czytania</span>
                                </div>
                                <h3 class="text-xl font-bold text-gray-900 mb-3 line-clamp-2 flex-grow">@article.Title</h3>
                                <p class="text-gray-600 mb-4 line-clamp-3">@article.Excerpt</p>
                                <div class="flex items-center gap-3 mb-4">
                                    <img src="@article.AuthorPhoto" 
                                         alt="@article.Author" 
                                         class="w-10 h-10 rounded-full object-cover"
                                         loading="lazy" />
                                    <div class="text-sm">
                                        <div class="font-semibold text-gray-900">@article.Author</div>
                                        <div class="text-gray-600">@article.AuthorRole</div>
                                    </div>
                                </div>
                                <a href="/porady/@article.Id"
                                   class="w-full py-3 border-2 border-gray-900 text-gray-900 font-semibold rounded-lg hover:bg-gray-900 hover:text-white transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-900/50 touch-manipulation text-center block">
                                    Czytaj wiêcej
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
        </div>
    </div>
</section>

<!-- Newsletter Section -->
<section class="py-20 bg-white">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
            <div class="bg-gradient-to-br from-gold-500 to-gold-600 rounded-3xl p-12 text-gray-900">
                <svg class="w-16 h-16 mx-auto mb-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Newsletter z&nbsp;Poradami</h2>
                <p class="text-lg mb-8 text-gray-800">
                    Otrzymuj najnowsze artyku³y, porady ekspertów i&nbsp;aktualizacje z&nbsp;rynku nieruchomoœci bezpoœrednio na swoj¹ skrzynkê
                </p>
                <form class="max-w-md mx-auto" @onsubmit="SubscribeNewsletter" @onsubmit:preventDefault>
                    <div class="flex flex-col sm:flex-row gap-3">
                        <input 
                            type="email" 
                            @bind="newsletterEmail"
                            placeholder="Twój adres e-mail…"
                            required
                            class="flex-1 px-6 py-4 rounded-lg border-2 border-gray-900/20 focus:outline-none focus:border-gray-900 focus:ring-4 focus:ring-gray-900/20 text-gray-900 placeholder-gray-600"
                            aria-label="Adres email do newslettera" />
                        <button 
                            type="submit"
                            class="px-8 py-4 bg-gray-900 text-white font-semibold rounded-lg hover:bg-gray-800 transition-colors focus:outline-none focus-visible:ring-4 focus-visible:ring-gray-900/50 touch-manipulation whitespace-nowrap">
                            Zapisz siê
                        </button>
                    </div>
                    @if (!string.IsNullOrEmpty(newsletterMessage))
                    {
                        <div class="mt-4 p-3 bg-white/90 rounded-lg text-gray-900 font-medium">
                            @newsletterMessage
                        </div>
                    }
                </form>
            </div>
        </div>
    </div>
</section>

