@code {
    private class ContactFormData
    {
        public string Name { get; set; } = "";
        public string Email { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Subject { get; set; } = "";
        public string Message { get; set; } = "";
        public bool GdprConsent { get; set; }
    }
    
    private ContactFormData formData = new();
    private Dictionary<string, string> errors = new();
    private bool isSubmitting = false;
    private string submitMessage = "";
    private bool submitSuccess = false;
    
    private string GetFieldErrorClass(string fieldName)
    {
        return errors.ContainsKey(fieldName) ? "border-red-500 focus:border-red-500" : "";
    }
    
    private async Task HandleSubmit()
    {
        errors.Clear();
        submitMessage = "";
        
        if (string.IsNullOrWhiteSpace(formData.Name))
            errors[nameof(formData.Name)] = "Pole wymagane";
            
        if (string.IsNullOrWhiteSpace(formData.Email))
            errors[nameof(formData.Email)] = "Pole wymagane";
        else if (!IsValidEmail(formData.Email))
            errors[nameof(formData.Email)] = "Nieprawid³owy adres email";
            
        if (string.IsNullOrWhiteSpace(formData.Phone))
            errors[nameof(formData.Phone)] = "Pole wymagane";
            
        if (string.IsNullOrWhiteSpace(formData.Message))
            errors[nameof(formData.Message)] = "Pole wymagane";
        else if (formData.Message.Length < 10)
            errors[nameof(formData.Message)] = "Wiadomoœæ jest zbyt krótka (min. 10 znaków)";
            
        if (!formData.GdprConsent)
        {
            submitMessage = "Musisz wyraziæ zgodê na przetwarzanie danych osobowych";
            submitSuccess = false;
            return;
        }
        
        if (errors.Any())
        {
            submitMessage = "Proszê poprawiæ b³êdy w formularzu";
            submitSuccess = false;
            return;
        }
        
        isSubmitting = true;
        StateHasChanged();
        
        await Task.Delay(1500);
        
        isSubmitting = false;
        submitSuccess = true;
        submitMessage = "Dziêkujemy za wiadomoœæ! Skontaktujemy siê z Tob¹ w ci¹gu 24 godzin.";
        
        formData = new ContactFormData();
        StateHasChanged();
    }
    
    private bool IsValidEmail(string email)
    {
        try
        {
            var addr = new System.Net.Mail.MailAddress(email);
            return addr.Address == email;
        }
        catch
        {
            return false;
        }
    }
}
