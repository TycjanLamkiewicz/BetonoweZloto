@page "/oferty"
@using System.Globalization
@using BetonoweZloto.Resources
@inject LocalizationHelper L
@inject LanguageService LanguageService
@rendermode InteractiveServer
@implements IDisposable

<PageTitle>@L.Get(LocalizationResources.SearchPage.Title) - BetonoweZloto.pl</PageTitle>

<div class="bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white py-20">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6">@L.Get(LocalizationResources.SearchPage.Title)</h1>
            <p class="text-xl md:text-2xl text-gray-300 leading-relaxed">@L.Get(LocalizationResources.SearchPage.Subtitle)</p>
        </div>
    </div>
</div>

<div class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">
        <aside class="w-full lg:w-1/4">
            <div class="bg-white p-6 rounded-xl shadow-lg sticky top-24 border border-gray-100">
                <h2 class="text-xl font-bold mb-6 pb-2 border-b border-gray-200">@L.Get(LocalizationResources.SearchPage.Filters)</h2>

                <div class="space-y-6">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">@L.Get(LocalizationResources.SearchPage.Location)</label>
                        <div class="relative">
                            <input @bind="SearchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="@EnterKeyHandler"
                                   type="text"
                                   class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-transparent outline-none transition-all"
                                   placeholder="@L.Get(LocalizationResources.SearchPage.LocationPlaceholder)" />
                            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">@L.Get(LocalizationResources.SearchPage.PropertyType)</label>
                        <select @bind="SelectedType" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 outline-none cursor-pointer">
                            <option value="">@L.Get(LocalizationResources.SearchPage.AllTypes)</option>
                            <option value="Mieszkanie">@L.Get(LocalizationResources.SearchPage.Apartment)</option>
                            <option value="Dom">@L.Get(LocalizationResources.SearchPage.House)</option>
                            <option value="Lokal">@L.Get(LocalizationResources.SearchPage.Commercial)</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">@L.Get(LocalizationResources.SearchPage.MaxPrice)</label>
                        <input @bind="MaxPrice"
                               type="number"
                               class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 outline-none"
                               placeholder="@L.Get(LocalizationResources.SearchPage.NoLimit)" />
                    </div>

                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">@L.Get(LocalizationResources.SearchPage.Rooms)</label>
                        <div class="flex gap-2">
                            @for (int i = 1; i <= 4; i++)
                            {
                                var roomCount = i;
                                <button @onclick="() => SetTargetRooms(roomCount)"
                                        class="flex-1 py-2 rounded-lg border transition-all focus:outline-none focus:ring-2 focus:ring-gold-500 @(TargetRooms == roomCount ? "bg-gold-500 text-white border-gold-500 shadow-md" : "bg-white text-gray-700 border-gray-300 hover:border-gold-500 hover:bg-gold-50")">
                                    @roomCount
                                </button>
                            }
                            <button @onclick="() => SetTargetRooms(0)"
                                    title="Dowolna liczba pokoi"
                                    class="px-3 py-2 rounded-lg border transition-all focus:outline-none focus:ring-2 focus:ring-gold-500 @(TargetRooms == 0 ? "bg-gold-500 text-white border-gold-500 shadow-md" : "bg-white text-gray-700 border-gray-300 hover:border-gold-500 hover:bg-gold-50")">
                                &#x2715;
                            </button>
                        </div>
                    </div>

                    <button @onclick="FilterProperties"
                            class="w-full bg-gray-900 text-white py-3 rounded-lg font-bold hover:bg-gold-600 transition-all shadow-md mt-4 focus:outline-none focus:ring-4 focus:ring-gold-500/50 active:scale-95">
                        @L.Get(LocalizationResources.SearchPage.FilterButton)
                    </button>

                    <button @onclick="ResetFilters" class="w-full text-sm text-gray-500 hover:text-gold-600 underline decoration-dotted">
                        @L.Get(LocalizationResources.SearchPage.ClearFilters)
                    </button>
                </div>
            </div>
        </aside>

        <main class="w-full lg:w-3/4">
            <div class="mb-6 flex justify-between items-center bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                <p class="text-gray-600">@L.Get(LocalizationResources.SearchPage.ResultsCount) <span class="font-bold text-gray-900">@FilteredProperties.Count</span></p>
            </div>

            @if (FilteredProperties.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var property in FilteredProperties)
                    {
                        <article class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col group">
                            <div class="relative h-56 overflow-hidden">
                                <img src="@property.ImageUrl" alt="@property.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                                <div class="absolute top-0 inset-x-0 h-16 bg-gradient-to-b from-black/50 to-transparent"></div>
                                <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-bold text-gray-900 shadow-sm">
                                    @property.Type
                                </div>
                                <div class="absolute top-3 left-3 text-white font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                    @property.City
                                </div>
                            </div>
                            <div class="p-5 flex-1 flex flex-col">
                                <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-gold-600 transition-colors">@property.Title</h3>
                                <p class="text-gold-600 font-bold text-2xl mb-4">@property.Price.ToString("N0", new CultureInfo("pl-PL")) @L.Get(LocalizationResources.Common.Currency)</p>

                                <div class="grid grid-cols-2 gap-y-2 gap-x-4 mb-6 text-gray-600 text-sm border-t border-b border-gray-100 py-4">
                                    <div class="flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                                        @property.Area @L.Get(LocalizationResources.Common.Area)
                                    </div>
                                    <div class="flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                                        @property.Rooms @L.Get(LocalizationResources.Common.RoomsShort)
                                    </div>
                                </div>

                                <a href="/oferty/@property.Id" class="w-full mt-auto bg-gray-50 text-gray-900 border border-gray-200 py-3 rounded-lg font-semibold hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gray-200 text-center block">
                                    @L.Get(LocalizationResources.SearchPage.ViewDetails)
                                </a>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl p-12 text-center shadow-lg border border-gray-100">
                    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">@L.Get(LocalizationResources.SearchPage.NoResults)</h3>
                    <p class="text-gray-500 max-w-md mx-auto mb-8">@L.Get(LocalizationResources.SearchPage.NoResultsText)</p>
                    <button @onclick="ResetFilters" class="inline-flex items-center px-6 py-3 rounded-lg bg-gold-500 text-gray-900 font-bold hover:bg-gold-400 transition-colors shadow-md">
                        @L.Get(LocalizationResources.SearchPage.ClearFilters)
                        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    </button>
                </div>
            }
        </main>
    </div>
</div>

<section id="kontakt" class="py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white" role="region" aria-labelledby="cta-heading">
    <div class="container mx-auto px-4 text-center">
        <h2 id="cta-heading" class="text-4xl md:text-5xl font-bold mb-6">
            @L.Get(LocalizationResources.HomePage.CtaHeading)
        </h2>
        <p class="text-xl mb-8 text-gray-300 max-w-2xl mx-auto">
            @L.Get(LocalizationResources.HomePage.CtaText)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="tel:+48123456789" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-gold-500 text-gray-900 hover:bg-gold-400 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gold-500/50 touch-manipulation"
               aria-label="Zadzwoń do nas: +48 123 456 789">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                +48&nbsp;123&nbsp;456&nbsp;789
            </a>
            <a href="mailto:kontakt@betonowezloto.pl" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 border-2 border-white/30 focus:outline-none focus:ring-4 focus:ring-white/50 touch-manipulation"
               aria-label="Napisz do nas email na adres kontakt@betonowezloto.pl">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                kontakt@betonowezloto.pl
            </a>
        </div>
    </div>
</section>

@code {
    private class PropertyListing
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Location { get; set; } = "";
        public string City { get; set; } = "";
        public string Type { get; set; } = "";
        public decimal Price { get; set; }
        public int Area { get; set; }
        public int Rooms { get; set; }
        public string ImageUrl { get; set; } = "";
    }

    private string SearchQuery { get; set; } = "";
    private string SelectedType { get; set; } = "";
    private decimal? MaxPrice { get; set; }
    private int TargetRooms { get; set; } = 0;

    private List<PropertyListing> AllProperties = new();
    private List<PropertyListing> FilteredProperties = new();

    protected override void OnInitialized()
    {
        AllProperties = new List<PropertyListing>
        {
            new PropertyListing { Id = 1, Title = "Nowoczesne Mieszkanie", Location = "Warszawa, Śródmieście", City = "Warszawa", Type = "Mieszkanie", Price = 890000, Area = 65, Rooms = 3, ImageUrl = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800" },
            new PropertyListing { Id = 2, Title = "Dom z Ogrodem", Location = "Kraków, Bronowice", City = "Kraków", Type = "Dom", Price = 1450000, Area = 180, Rooms = 5, ImageUrl = "https://images.unsplash.com/photo-1568605114967-8130f3a36994?q=80&w=800" },
            new PropertyListing { Id = 3, Title = "Apartament", Location = "Gdańsk, Przymorze", City = "Gdańsk", Type = "Mieszkanie", Price = 720000, Area = 52, Rooms = 2, ImageUrl = "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?q=80&w=800" },
            new PropertyListing { Id = 4, Title = "Penthouse", Location = "Wrocław, Psie Pole", City = "Wrocław", Type = "Mieszkanie", Price = 2100000, Area = 120, Rooms = 8, ImageUrl = "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=800" },
            new PropertyListing { Id = 5, Title = "Kameralne Mieszkanie", Location = "Poznań, Jeżyce", City = "Poznań", Type = "Mieszkanie", Price = 420000, Area = 38, Rooms = 2, ImageUrl = "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?q=80&w=800" },
            new PropertyListing { Id = 6, Title = "Dom z Tarasem", Location = "Katowice, Ligota", City = "Katowice", Type = "Dom", Price = 980000, Area = 145, Rooms = 4, ImageUrl = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=800" },
            new PropertyListing { Id = 7, Title = "Lokal Biurowy", Location = "Warszawa, Mokotów", City = "Warszawa", Type = "Lokal", Price = 650000, Area = 80, Rooms = 3, ImageUrl = "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800" },
            new PropertyListing { Id = 8, Title = "Rezydencja", Location = "Gdynia, Orłowo", City = "Gdynia", Type = "Dom", Price = 2300000, Area = 220, Rooms = 6, ImageUrl = "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=800" }
        };

        FilteredProperties = new List<PropertyListing>(AllProperties);
        LanguageService.OnLanguageChanged += OnLanguageChanged;
    }

    private void EnterKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            FilterProperties();
        }
    }

    private void SetTargetRooms(int count)
    {
        TargetRooms = count;
    }

    private void FilterProperties()
    {
        var query = AllProperties.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            query = query.Where(p =>
                p.Location.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.City.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));
        }

        if (!string.IsNullOrEmpty(SelectedType))
        {
            query = query.Where(p => p.Type == SelectedType);
        }

        if (MaxPrice.HasValue && MaxPrice.Value > 0)
        {
            query = query.Where(p => p.Price <= MaxPrice.Value);
        }

        if (TargetRooms > 0)
        {
            query = query.Where(p => p.Rooms == TargetRooms);
        }

        FilteredProperties = query.ToList();
    }

    private void ResetFilters()
    {
        SearchQuery = "";
        SelectedType = "";
        MaxPrice = null;
        TargetRooms = 0;
        FilteredProperties = new List<PropertyListing>(AllProperties);
    }

    private void OnLanguageChanged()
    {
        StateHasChanged();
    }

    public void Dispose()
    {
        LanguageService.OnLanguageChanged -= OnLanguageChanged;
    }
}
