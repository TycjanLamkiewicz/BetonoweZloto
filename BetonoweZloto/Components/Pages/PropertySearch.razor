@page "/oferty"
@using System.Globalization
@rendermode InteractiveServer

<PageTitle>Wyszukiwarka Ofert - BetonoweZloto.pl</PageTitle>

<!-- Header -->
<div class="bg-gray-900 text-white py-12">
    <div class="container mx-auto px-4 text-center">
        <h1 class="text-3xl md:text-4xl font-bold mb-4">Znajdź Nieruchomość</h1>
        <p class="text-gray-400">Przeszukaj naszą bazę, aby znaleźć idealne miejsce dla siebie.</p>
    </div>
</div>

<div class="container mx-auto px-4 py-12">
    <div class="flex flex-col lg:flex-row gap-8">

        <!-- Filters Sidebar -->
        <aside class="w-full lg:w-1/4">
            <div class="bg-white p-6 rounded-xl shadow-lg sticky top-24 border border-gray-100">
                <h2 class="text-xl font-bold mb-6 pb-2 border-b border-gray-200">Filtry</h2>

                <div class="space-y-6">
                    <!-- Search Text -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Lokalizacja lub słowo kluczowe</label>
                        <div class="relative">
                            <input @bind="SearchQuery"
                                   @bind:event="oninput"
                                   @onkeydown="@EnterKeyHandler"
                                   type="text"
                                   class="w-full pl-10 pr-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 focus:border-transparent outline-none transition-all"
                                   placeholder="np. Warszawa..." />
                            <svg class="w-5 h-5 text-gray-400 absolute left-3 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                            </svg>
                        </div>
                    </div>

                    <!-- Type -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Typ nieruchomości</label>
                        <select @bind="SelectedType" class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 outline-none cursor-pointer">
                            <option value="">Wszystkie</option>
                            <option value="Mieszkanie">Mieszkanie</option>
                            <option value="Dom">Dom</option>
                            <option value="Lokal">Lokal użytkowy</option>
                        </select>
                    </div>

                    <!-- Price Range -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Cena maksymalna (zł)</label>
                        <input @bind="MaxPrice"
                               type="number"
                               class="w-full px-4 py-2 rounded-lg border border-gray-300 focus:ring-2 focus:ring-gold-500 outline-none"
                               placeholder="Bez limitu" />
                    </div>

                    <!-- Rooms -->
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">Minimalna liczba pokoi</label>
                        <div class="flex gap-2">
                            @for (int i = 1; i <= 4; i++)
                            {
                                var roomCount = i;
                                <button @onclick="() => SetMinRooms(roomCount)"
                                        class="flex-1 py-2 rounded-lg border transition-all focus:outline-none focus:ring-2 focus:ring-gold-500 @(MinRooms == roomCount ? "bg-gold-500 text-white border-gold-500 shadow-md" : "bg-white text-gray-700 border-gray-300 hover:border-gold-500 hover:bg-gold-50")">
                                    @roomCount+
                                </button>
                            }
                            <button @onclick="() => SetMinRooms(0)"
                                    title="Dowolna liczba pokoi"
                                    class="px-3 py-2 rounded-lg border transition-all focus:outline-none focus:ring-2 focus:ring-gold-500 @(MinRooms == 0 ? "bg-gold-500 text-white border-gold-500 shadow-md" : "bg-white text-gray-700 border-gray-300 hover:border-gold-500 hover:bg-gold-50")">
                                &#x2715;
                            </button>
                        </div>
                    </div>

                    <!-- Filter Button -->
                    <button @onclick="FilterProperties"
                            class="w-full bg-gray-900 text-white py-3 rounded-lg font-bold hover:bg-gold-600 transition-all shadow-md mt-4 focus:outline-none focus:ring-4 focus:ring-gold-500/50 active:scale-95">
                        Filtruj Wyniki
                    </button>

                    <button @onclick="ResetFilters" class="w-full text-sm text-gray-500 hover:text-gold-600 underline decoration-dotted">
                        Wyczyść wszystkie filtry
                    </button>
                </div>
            </div>
        </aside>

        <!-- Results Grid -->
        <main class="w-full lg:w-3/4">
            <div class="mb-6 flex justify-between items-center bg-white p-4 rounded-lg shadow-sm border border-gray-100">
                <p class="text-gray-600">Znaleziono ofert: <span class="font-bold text-gray-900">@FilteredProperties.Count</span></p>

                <!-- Sortowanie (opcjonalne) -->
                <div class="flex items-center gap-2">
                    <span class="text-sm text-gray-500 hidden sm:inline">Sortuj:</span>
                    <select class="text-sm border-gray-300 rounded-md focus:ring-gold-500 focus:border-gold-500">
                        <option>Najnowsze</option>
                        <option>Cena: rosnąco</option>
                        <option>Cena: malejąco</option>
                    </select>
                </div>
            </div>

            @if (FilteredProperties.Any())
            {
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    @foreach (var property in FilteredProperties)
                    {
                        <article class="bg-white rounded-2xl shadow-md overflow-hidden hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col group">
                            <div class="relative h-56 overflow-hidden">
                                <img src="@property.ImageUrl" alt="@property.Title" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" />
                                <div class="absolute top-0 inset-x-0 h-16 bg-gradient-to-b from-black/50 to-transparent"></div>
                                <div class="absolute top-3 right-3 bg-white/95 backdrop-blur-sm px-3 py-1 rounded-full text-sm font-bold text-gray-900 shadow-sm">
                                    @property.Type
                                </div>
                                <div class="absolute top-3 left-3 text-white font-medium flex items-center">
                                    <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" /><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" /></svg>
                                    @property.City
                                </div>
                            </div>
                            <div class="p-5 flex-1 flex flex-col">
                                <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-gold-600 transition-colors">@property.Title</h3>
                                <p class="text-gold-600 font-bold text-2xl mb-4">@property.Price.ToString("N0", new CultureInfo("pl-PL")) zł</p>

                                <div class="grid grid-cols-2 gap-y-2 gap-x-4 mb-6 text-gray-600 text-sm border-t border-b border-gray-100 py-4">
                                    <div class="flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4" /></svg>
                                        @property.Area m²
                                    </div>
                                    <div class="flex items-center">
                                        <svg class="w-5 h-5 mr-2 text-gold-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                                        @property.Rooms pok.
                                    </div>
                                </div>

                                <button class="w-full mt-auto bg-gray-50 text-gray-900 border border-gray-200 py-3 rounded-lg font-semibold hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gray-200">
                                    Zobacz szczegóły
                                </button>
                            </div>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="bg-white rounded-2xl p-12 text-center shadow-lg border border-gray-100">
                    <div class="w-20 h-20 bg-gray-100 rounded-full flex items-center justify-center mx-auto mb-6">
                        <svg class="w-10 h-10 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" /></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-gray-900 mb-2">Brak wyników wyszukiwania</h3>
                    <p class="text-gray-500 max-w-md mx-auto mb-8">Nie znaleźliśmy ofert spełniających Twoje kryteria. Spróbuj zmienić parametry wyszukiwania lub wyczyść filtry.</p>
                    <button @onclick="ResetFilters" class="inline-flex items-center px-6 py-3 rounded-lg bg-gold-500 text-gray-900 font-bold hover:bg-gold-400 transition-colors shadow-md">
                        Wyczyść filtry
                        <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" /></svg>
                    </button>
                </div>
            }
        </main>
    </div>
</div>

@code {
    // Modele danych
    private class PropertyListing
    {
        public int Id { get; set; }
        public string Title { get; set; } = "";
        public string Location { get; set; } = "";
        public string City { get; set; } = "";
        public string Type { get; set; } = ""; // Mieszkanie, Dom, Lokal
        public decimal Price { get; set; }
        public int Area { get; set; }
        public int Rooms { get; set; }
        public string ImageUrl { get; set; } = "";
    }

    // Pola filtrów
    private string SearchQuery { get; set; } = "";
    private string SelectedType { get; set; } = "";
    private decimal? MaxPrice { get; set; }
    private int MinRooms { get; set; } = 0;

    // Dane
    private List<PropertyListing> AllProperties = new();
    private List<PropertyListing> FilteredProperties = new();

    protected override void OnInitialized()
    {
        // Mock danych (odpowiada stylowi ze strony głównej)
        AllProperties = new List<PropertyListing>
        {
            new PropertyListing { Id = 1, Title = "Nowoczesne Mieszkanie w Centrum", Location = "Warszawa, Śródmieście", City = "Warszawa", Type = "Mieszkanie", Price = 890000, Area = 65, Rooms = 3, ImageUrl = "https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?q=80&w=800" },
            new PropertyListing { Id = 2, Title = "Przestronny Dom z Ogrodem", Location = "Kraków, Bronowice", City = "Kraków", Type = "Dom", Price = 1450000, Area = 180, Rooms = 5, ImageUrl = "https://images.unsplash.com/photo-1568605114967-8130f3a36994?q=80&w=800" },
            new PropertyListing { Id = 3, Title = "Apartament z Widokiem na Morze", Location = "Gdańsk, Przymorze", City = "Gdańsk", Type = "Mieszkanie", Price = 720000, Area = 52, Rooms = 2, ImageUrl = "https://images.unsplash.com/photo-1545324418-cc1a3fa10c00?q=80&w=800" },
            new PropertyListing { Id = 4, Title = "Luksusowy Penthouse", Location = "Wrocław, Stare Miasto", City = "Wrocław", Type = "Mieszkanie", Price = 2100000, Area = 120, Rooms = 4, ImageUrl = "https://images.unsplash.com/photo-1512917774080-9991f1c4c750?q=80&w=800" },
            new PropertyListing { Id = 5, Title = "Kameralne Mieszkanie dla Singla", Location = "Poznań, Jeżyce", City = "Poznań", Type = "Mieszkanie", Price = 420000, Area = 38, Rooms = 2, ImageUrl = "https://images.unsplash.com/photo-1502672260266-1c1ef2d93688?q=80&w=800" },
            new PropertyListing { Id = 6, Title = "Rodzinny Dom z Tarasem", Location = "Katowice, Ligota", City = "Katowice", Type = "Dom", Price = 980000, Area = 145, Rooms = 4, ImageUrl = "https://images.unsplash.com/photo-1570129477492-45c003edd2be?q=80&w=800" },
            new PropertyListing { Id = 7, Title = "Lokal Biurowy Klasy A", Location = "Warszawa, Mokotów", City = "Warszawa", Type = "Lokal", Price = 650000, Area = 80, Rooms = 3, ImageUrl = "https://images.unsplash.com/photo-1497366216548-37526070297c?q=80&w=800" },
            new PropertyListing { Id = 8, Title = "Rezydencja pod Lasem", Location = "Gdynia, Orłowo", City = "Gdynia", Type = "Dom", Price = 2300000, Area = 220, Rooms = 6, ImageUrl = "https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=800" }
        };

        FilteredProperties = new List<PropertyListing>(AllProperties);
    }

    // Pozwala filtrować po naciśnięciu Enter w polu tekstowym
    private void EnterKeyHandler(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            FilterProperties();
        }
    }

    private void SetMinRooms(int count)
    {
        MinRooms = count;
        // Opcjonalnie odkomentuj, jeśli chcesz filtrować natychmiast po kliknięciu w liczbę pokoi
        // FilterProperties();
    }

    private void FilterProperties()
    {
        var query = AllProperties.AsEnumerable();

        // Filtrowanie po tekście (Title, Location lub City)
        if (!string.IsNullOrWhiteSpace(SearchQuery))
        {
            query = query.Where(p =>
                p.Location.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.Title.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase) ||
                p.City.Contains(SearchQuery, StringComparison.OrdinalIgnoreCase));
        }

        // Filtrowanie po typie
        if (!string.IsNullOrEmpty(SelectedType))
        {
            query = query.Where(p => p.Type == SelectedType);
        }

        // Filtrowanie po cenie
        if (MaxPrice.HasValue && MaxPrice.Value > 0)
        {
            query = query.Where(p => p.Price <= MaxPrice.Value);
        }

        // Filtrowanie po liczbie pokoi
        if (MinRooms > 0)
        {
            query = query.Where(p => p.Rooms >= MinRooms);
        }

        FilteredProperties = query.ToList();
    }

    private void ResetFilters()
    {
        SearchQuery = "";
        SelectedType = "";
        MaxPrice = null;
        MinRooms = 0;
        FilteredProperties = new List<PropertyListing>(AllProperties);
    }
}
