@page "/"
@using BetonoweZloto.Resources
@inject LocalizationHelper L
@inject LanguageService LanguageService
@implements IDisposable

<PageTitle>BetonoweZłoto.pl - Profesjonalne Biuro Obrotu Nieruchomościami</PageTitle>

<section class="relative h-[90vh] min-h-[600px] overflow-hidden" role="region" aria-label="Główny baner">
    <div class="absolute inset-0 bg-gradient-to-r from-gray-900/80 to-gray-900/40 z-10"></div>
    
    <div class="absolute inset-0 bg-cover bg-center bg-no-repeat" 
         style="background-image: url('https://images.unsplash.com/photo-1600596542815-ffad4c1539a9?q=80&w=2000');"
         role="img"
         aria-label="Nowoczesny dom z dużymi oknami">
    </div>
    
    <div class="relative z-20 container mx-auto px-4 h-full flex items-center">
        <div class="max-w-3xl text-white">
            <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold mb-6 leading-tight">
                @L.Get(LocalizationResources.HomePage.Title)
                <span class="text-gold-400 block">@L.Get(LocalizationResources.HomePage.TitleHighlight)</span>
            </h1>
            <p class="text-xl md:text-2xl mb-8 text-gray-200 leading-relaxed">
                @L.Get(LocalizationResources.HomePage.Subtitle)
            </p>
            <div class="flex flex-col sm:flex-row gap-4">
                <a href="/oferty" 
                   class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg bg-gold-500 text-gray-900 hover:bg-gold-400 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gold-500/50 touch-manipulation"
                   aria-label="Zobacz nasze oferty nieruchomości">
                    @L.Get(LocalizationResources.HomePage.ViewOffers)
                    <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                </a>
                <a href="#kontakt" 
                   class="inline-flex items-center justify-center px-8 py-4 text-lg font-semibold rounded-lg bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 border-2 border-white/30 focus:outline-none focus:ring-4 focus:ring-white/50 touch-manipulation"
                   aria-label="Skontaktuj się z nami">
                    @L.Get(LocalizationResources.HomePage.ContactUs)
                </a>
            </div>
        </div>
    </div>
    
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 z-20 animate-bounce">
        <a href="#o-nas" class="text-white/80 hover:text-white transition-colors focus:outline-none focus:ring-2 focus:ring-white/50 rounded-full p-2" aria-label="Przewiń w dół">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/>
            </svg>
        </a>
    </div>
</section>

<section id="o-nas" class="py-20 bg-gray-50" role="region" aria-labelledby="about-heading">
    <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center mb-16">
            <h2 id="about-heading" class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                @L.Get(LocalizationResources.HomePage.AboutHeading)
            </h2>
            <p class="text-xl text-gray-600 leading-relaxed">
                @L.Get(LocalizationResources.HomePage.AboutText)
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
            <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.HomePage.ExperienceTitle)</h3>
                <p class="text-gray-600 leading-relaxed">
                    @L.Get(LocalizationResources.HomePage.ExperienceText)
                </p>
            </div>
            
            <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.HomePage.TeamTitle)</h3>
                <p class="text-gray-600 leading-relaxed">
                    @L.Get(LocalizationResources.HomePage.TeamText)
                </p>
            </div>
            
            <div class="bg-white p-8 rounded-2xl shadow-lg hover:shadow-xl transition-shadow duration-300">
                <div class="w-16 h-16 bg-gold-100 rounded-full flex items-center justify-center mb-6">
                    <svg class="w-8 h-8 text-gold-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                    </svg>
                </div>
                <h3 class="text-2xl font-bold text-gray-900 mb-4">@L.Get(LocalizationResources.HomePage.PortfolioTitle)</h3>
                <p class="text-gray-600 leading-relaxed">
                    @L.Get(LocalizationResources.HomePage.PortfolioText)
                </p>
            </div>
        </div>
    </div>
</section>

<section id="oferty" class="py-20 bg-white" role="region" aria-labelledby="properties-heading">
    <div class="container mx-auto px-4">
        <div class="text-center mb-16">
            <h2 id="properties-heading" class="text-4xl md:text-5xl font-bold text-gray-900 mb-6">
                @L.Get(LocalizationResources.HomePage.FeaturedHeading)
            </h2>
            <p class="text-xl text-gray-600">
                @L.Get(LocalizationResources.HomePage.FeaturedSubheading)
            </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
            @foreach (var property in FeaturedProperties)
            {
                <article class="bg-white rounded-2xl shadow-lg overflow-hidden hover:shadow-2xl transition-shadow duration-300 group">
                    <div class="relative overflow-hidden aspect-[4/3]">
                        <img src="@property.ImageUrl" 
                             alt="@property.Title" 
                             class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500"
                             loading="lazy"
                             width="600"
                             height="450" />
                        <div class="absolute top-4 right-4 bg-gold-500 text-gray-900 px-4 py-2 rounded-full font-bold text-lg shadow-lg">
                            @property.Price
                        </div>
                    </div>
                    <div class="p-6">
                        <h3 class="text-2xl font-bold text-gray-900 mb-3 line-clamp-2">@property.Title</h3>
                        <div class="flex items-center text-gray-600 mb-4">
                            <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/>
                            </svg>
                            <span>@property.Location</span>
                        </div>
                        <div class="flex gap-6 mb-6 text-gray-700">
                            <div class="flex items-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-1V4m0 0h-4m4 0l-5 5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/>
                                </svg>
                                <span>@property.Area&nbsp;@L.Get(LocalizationResources.Common.Area)</span>
                            </div>
                            <div class="flex items-center">
                                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>
                                </svg>
                                <span>@property.Rooms&nbsp;@L.Get(LocalizationResources.Common.Rooms)</span>
                            </div>
                        </div>
                        <button class="w-full bg-gray-900 text-white py-3 rounded-lg font-semibold hover:bg-gray-800 transition-colors duration-300 focus:outline-none focus:ring-4 focus:ring-gray-900/50 touch-manipulation"
                                onclick="@($"window.location.href='/oferty/{property.Id}'")"
                                aria-label="Zobacz szczegóły oferty @property.Title">
                            @L.Get(LocalizationResources.SearchPage.ViewDetails)
                        </button>
                    </div>
                </article>
            }
        </div>
        
        <div class="text-center mt-12">
            <a href="/oferty" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-gold-500 text-gray-900 hover:bg-gold-400 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gold-500/50 touch-manipulation"
               aria-label="Zobacz wszystkie dostępne oferty">
                @L.Get(LocalizationResources.HomePage.ViewAllOffers)
                <svg class="ml-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
            </a>
        </div>
    </div>
</section>

<section id="kontakt" class="py-20 bg-gradient-to-br from-gray-900 via-gray-800 to-gold-900 text-white" role="region" aria-labelledby="cta-heading">
    <div class="container mx-auto px-4 text-center">
        <h2 id="cta-heading" class="text-4xl md:text-5xl font-bold mb-6">
            @L.Get(LocalizationResources.HomePage.CtaHeading)
        </h2>
        <p class="text-xl mb-8 text-gray-300 max-w-2xl mx-auto">
            @L.Get(LocalizationResources.HomePage.CtaText)
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center">
            <a href="tel:+48123456789" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-gold-500 text-gray-900 hover:bg-gold-400 transition-all duration-300 focus:outline-none focus:ring-4 focus:ring-gold-500/50 touch-manipulation"
               aria-label="Zadzwoń do nas: +48 123 456 789">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
                +48&nbsp;123&nbsp;456&nbsp;789
            </a>
            <a href="mailto:kontakt@betonowezloto.pl" 
               class="inline-flex items-center px-8 py-4 text-lg font-semibold rounded-lg bg-white/10 backdrop-blur-sm text-white hover:bg-white/20 transition-all duration-300 border-2 border-white/30 focus:outline-none focus:ring-4 focus:ring-white/50 touch-manipulation"
               aria-label="Napisz do nas email na adres kontakt@betonowezloto.pl">
                <svg class="w-6 h-6 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
                kontakt@betonowezloto.pl
            </a>
        </div>
    </div>
</section>

